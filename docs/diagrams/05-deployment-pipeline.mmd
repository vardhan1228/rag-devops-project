%% CI/CD pipeline. The apply is split because Terraform owns the registries,
%% but ECS and Lambda cannot start until an image exists inside them.
flowchart TB
  dev["git push to main"]
  prq["Pull request<br/>checks only, never deploys"]
  manual["State bucket<br/>created once by hand"]

  subgraph gha["GitHub Actions · deploy workflow"]
    direction TB

    checks["1 · checks<br/>no AWS access, fails fast<br/>ruff check app<br/>terraform fmt -check<br/>terraform validate -backend=false"]

    subgraph d["2 · deploy · one job, four steps"]
      direction TB
      reg["a · registries<br/>terraform apply -target<br/>aws_ecr_repository.api<br/>aws_ecr_repository.ingest"]
      build["b · two images<br/>app/api/Dockerfile       -> api repo<br/>app/ingestion/Dockerfile -> ingest repo<br/>context is the repo root<br/>both tagged with the commit SHA"]
      app["c · workloads<br/>terraform apply, full<br/>TF_VAR_image_tag=SHA<br/>then wait services-stable"]
      data["d · corpus<br/>aws s3 sync --delete<br/>invoke Lambda reindex<br/>fail if 0 passages indexed"]
      reg --> build --> app --> data
    end

    smoke["3 · smoke<br/>/health returns 200<br/>/ready shows index_exists<br/>a real question returns citations"]

    checks --> reg
    data --> smoke
  end

  subgraph awsres["AWS"]
    direction LR
    tfstate[("S3 state bucket<br/>terraform.tfstate<br/>S3 native locking")]
    ecrapi[("ECR · api<br/>immutable tag = SHA")]
    ecring[("ECR · ingest<br/>immutable tag = SHA")]
    stack["VPC · ALB · ECS · Lambda<br/>OpenSearch · S3 · IAM<br/>Secrets · SQS · autoscaling"]
    corpus[("S3 uploads/<br/>10 documents")]
  end

  dev --> checks
  prq -.-> checks
  manual -.->|"you create this"| tfstate

  app -.->|"read and write state"| tfstate
  build -.->|"push"| ecrapi
  build -.->|"push"| ecring
  ecrapi -.->|"ECS pulls"| stack
  ecring -.->|"Lambda pulls"| stack
  app -.->|"create or update"| stack
  data -.-> corpus
  smoke -.->|"HTTP through the ALB"| stack

  gate["Why the split<br/><br/>Terraform creates the ECR repositories, but the ECS<br/>service and the Lambda both reference an image tag<br/>inside them. A single apply would fail on first run,<br/>because the tags do not exist yet."]

  classDef job fill:#e8f0fe,stroke:#4c8dff,color:#11203a
  classDef gateclass fill:#eaf7ee,stroke:#48a868,color:#11301c
  classDef store fill:#fff4e5,stroke:#e8a33d,color:#3a2a11
  classDef trigger fill:#f3e8ff,stroke:#9a4cff,color:#26113a
  classDef note fill:#fffbe6,stroke:#d4b106,color:#3a3111

  class reg,build,app,data job
  class checks,smoke gateclass
  class tfstate,ecrapi,ecring,stack,corpus store
  class dev,prq,manual trigger
  class gate note
